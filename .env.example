# Copy to .env and fill in. Never commit .env (see .gitignore).

# Where the bridge listens. Keep loopback unless you know what you are exposing.
DSHB_BIND=127.0.0.1
DSHB_PORT=3443

# Your existing `dsh web` endpoint. The bridge never starts or stops it.
DSHB_UPSTREAM=http://127.0.0.1:3080

# The token printed by `dsh web` (the ?token=... part). Stays on the computer.
# Leave empty if you prefer to paste the full tokenized link into the upstream host yourself.
DSHB_DSH_TOKEN=

# Optional lock-screen notification webhook.
# Supported out of the box: WeCom, Feishu/Lark, DingTalk; anything else gets generic JSON.
DSHB_WEBHOOK=
DSHB_WEBHOOK_KIND=auto
# Optional JSON template with {title}, {body}, {kind} placeholders.
DSHB_WEBHOOK_TEMPLATE=

# Serve HTTPS directly (both must be set together).
DSHB_TLS_CERT=
DSHB_TLS_KEY=

# Strict Origin check for state-changing requests. Set to your public HTTPS origin
# when running behind a tunnel, e.g. https://demo.example.com
DSHB_ORIGIN=

# Extra CSS selectors observed for notification events (comma-separated).
DSHB_NOTIFY_SELECTORS=

# Inject the mobile shim into DSH HTML pages (set to 0 to disable).
DSHB_INJECT=1

# Redirect straight into DSH after pairing (set to 1 to enable).
DSHB_AUTO_OPEN=0
